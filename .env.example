# ============================================================
# Radar Digital — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# La app FUNCIONA sin Supabase (el diagnóstico se calcula igual);
# solo que no se guardarán los envíos ni habrá datos en el panel.
# ============================================================

# --- Supabase (persistencia en base de datos) ---
# Crea un proyecto gratis en https://supabase.com, ejecuta supabase/schema.sql
# y copia aquí la URL del proyecto y la SERVICE ROLE key (Settings > API).
# OJO: la service role key es SECRETA. Nunca la expongas en el cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel administrador ---
# Clave para entrar a /admin y secreto para firmar la sesión.
ADMIN_PASSWORD=radar-admin-2026
ADMIN_SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Seguridad ---
# Sal para hashear las IP de auditoría (que no se guarden en crudo).
IP_HASH_SALT=cambia-esta-sal-aleatoria

# --- Asesor con IA — OPCIONAL (usa la PRIMERA key que encuentre) ---
# Activa el chat asesor en la pantalla de resultados. Sin esto, el
# diagnóstico y el plan por reglas siguen funcionando igual (gratis).
#
# GRATIS recomendado — Google Gemini (sin tarjeta de crédito):
#   key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# GRATIS — Groq (rápido, modelos Llama):
#   key en https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# De pago (mejor calidad) — Claude / Anthropic:
#   key en https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
#
# Otra opción (tiene modelos :free) — OpenRouter:
#   key en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- PostgreSQL local (Docker Compose) — OPCIONAL ---
# Si no se configura, la app sigue funcionando (Supabase o modo demo).
DATABASE_URL=postgresql://radar:CAMBIA_ESTO@db:5432/radar_digital
POSTGRES_PASSWORD=CAMBIA_ESTO

# --- Google Sheets — OPCIONAL ---
# ID del spreadsheet (la parte de la URL entre /d/ y /edit).
# Compartir la hoja con el email de la cuenta de servicio como Editor.
RADAR_SHEET_ID=
# JSON completo de la cuenta de servicio (en una sola línea, sin saltos).
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Automatización (n8n / Make / Zapier) — OPCIONAL ---
# Cada envío se reenvía (webhook POST) a esta URL. Úsalo para mandar los
# datos a Google Sheets, Google Drive, correo o un CRM sin escribir código.
N8N_WEBHOOK_URL=

# --- Contacto / legal (Habeas Data) — OPCIONAL ---
# Correo que aparece en la Política de Privacidad para ejercer derechos
# (consultar, actualizar o eliminar datos). Si se deja vacío, usa uno por defecto.
NEXT_PUBLIC_CONTACT_EMAIL=
