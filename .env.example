# ============================================================
# Radar Digital — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# La app FUNCIONA sin Supabase (el diagnóstico se calcula igual);
# solo que no se guardarán los envíos ni habrá datos en el panel.
# ============================================================

# --- Supabase (persistencia en base de datos) ---
# Crea un proyecto gratis en https://supabase.com, ejecuta supabase/schema.sql
# y copia aquí la URL del proyecto y la SERVICE ROLE key (Settings > API).
# OJO: la service role key es SECRETA. Nunca la expongas en el cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel administrador ---
# Clave para entrar a /admin y secreto para firmar la sesión.
ADMIN_PASSWORD=radar-admin-2026
ADMIN_SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Seguridad ---
# Sal para hashear las IP de auditoría (que no se guarden en crudo).
IP_HASH_SALT=cambia-esta-sal-aleatoria

# --- Asesor con IA (Claude / Anthropic) — OPCIONAL ---
# Activa el chat asesor en la pantalla de resultados. Sin esto, el
# diagnóstico y el plan por reglas siguen funcionando igual.
# Consigue una API key en https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo (por defecto el más capaz). Para reducir costo: claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-8

# --- Automatización (n8n / Make / Zapier) — OPCIONAL ---
# Cada envío se reenvía (webhook POST) a esta URL. Úsalo para mandar los
# datos a Google Sheets, Google Drive, correo o un CRM sin escribir código.
N8N_WEBHOOK_URL=
